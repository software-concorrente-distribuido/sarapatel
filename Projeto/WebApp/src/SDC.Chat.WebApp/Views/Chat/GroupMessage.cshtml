@model GroupMessageViewModel;

@{
    ViewData["Title"] = "Chat de Grupo";
}

<div class="container">
    <h2 class="text-center">@ViewData["Title"]</h2>
    <div class="chat-box">
        <ul id="messagesList" class="list-unstyled">
            @foreach (var message in Model.Messages)
            {
                <li class="text-end">
                    <strong>@message.Username</strong>  <small>@message.Date</small><br>@message.Content
                </li>
            }
        </ul>
    </div>
    <div class="input-group mb-3">
        <input type="text" class="form-control" id="messageInput" placeholder="Digite sua mensagem">
        <button class="btn btn-primary" id="sendButton" type="button">Enviar</button>
    </div>
</div>

<input type="hidden" id="groupId" value="@Model.GroupId" />

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/chat_group.js"></script>