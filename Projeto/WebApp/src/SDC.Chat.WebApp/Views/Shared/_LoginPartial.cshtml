@using Microsoft.AspNetCore.Identity
@using SDC.Chat.WebApp.Domain

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
            <a id="manage" type="button" class="nav-link btn btn-link text-dark border-0" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"> Olá @UserManager.GetUserName(User)!</a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Sair</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
            <a class="nav-link btn btn-link text-dark border-0" id="register" asp-area="Identity" asp-page="/Account/Register">Cadastrar-se</a>
    </li>
    <li class="nav-item">
            <a class="nav-link btn btn-link text-dark border-0" id="login" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
    </li>
}
</ul>

